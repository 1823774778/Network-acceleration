#!/bin/sh /etc/rc.common

START=19
STOP=89

USE_PROCD=1
PROG=/usr/bin/fastnatd

apply_switches() {
	local enabled dpi_compat

	config_load fastnat
	config_get_bool enabled global enabled 0
	config_get_bool dpi_compat global dpi_compat 1
	[ -e /sys/sfe_cm/enabled ] || modprobe shortcut-fe-cm
	[ -w /sys/sfe_cm/enabled ] && [ -w /sys/sfe_cm/dpi_compat ] || return 1
	if [ "$enabled" -eq 0 ]; then
		printf '0\n' > /sys/sfe_cm/enabled || return 1
	fi
	printf '%s\n' "$dpi_compat" > /sys/sfe_cm/dpi_compat || return 1
	printf '%s\n' "$enabled" > /sys/sfe_cm/enabled
}

start_service() {
	apply_switches

	# fwxd owns the "fwx" ubus object when installed; do not compete with it.
	if [ -x /usr/bin/fwxd ]; then
		return 0
	fi

	procd_open_instance
	procd_set_param command "$PROG"
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	apply_switches
}

service_triggers() {
	procd_add_reload_trigger "fastnat"
}

stop_service() {
	[ -w /sys/sfe_cm/enabled ] || return 0
	printf '0\n' > /sys/sfe_cm/enabled
}